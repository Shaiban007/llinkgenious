# ───────────────────────────────────────────────────────────────
# LinkGenius AI — environment variables
# Copy this file to ".env.local" and fill in the values.
# NEVER share .env.local or commit it to GitHub. It holds secrets.
# ───────────────────────────────────────────────────────────────

# 1) DATABASE (required)
# Option A (easiest, local): run "npm run db:local" in a second terminal, then use:
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5433/linkgenius"
# Option B (production): paste the connection string from Neon / Supabase / Railway.

# 2) LOGIN SECURITY (required)
# A long random text used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"
# The web address of your app. Local: http://localhost:3000  Production: your Vercel URL
NEXTAUTH_URL="http://localhost:3000"

# 3) ENCRYPTION KEY for API keys and email passwords saved in Settings (required)
# Must be exactly 64 hex characters. Generate with the same command as above.
ENCRYPTION_KEY="replace-me-with-64-hex-characters-0000000000000000000000000000"

# 4) CRON SECRET (optional locally, required in production)
# Protects /api/cron/tick, which sends reminders and queued approved emails.
CRON_SECRET="replace-me-with-another-random-string"

# 5) SYSTEM EMAIL (optional). Used for verification and password-reset emails.
# If left empty, those emails are printed in the terminal instead (fine for local use).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="LinkGenius AI <no-reply@yourdomain.com>"

# 6) Set to "true" to block login until the user clicks the email verification link.
# Only enable after SMTP above is working.
REQUIRE_EMAIL_VERIFICATION="false"
